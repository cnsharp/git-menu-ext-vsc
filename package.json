{
  "name": "git-menu-ext",
  "displayName": "Git Menu Ext",
  "description": "Git branch management, commit operations, file export, and editor context menu utilities",
  "version": "1.2.0",
  "publisher": "CnSharpStudio",
  "author": {
    "name": "CnSharp Studio",
    "url": "https://github.com/cnsharp"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cnsharp/git-menu-ext-vsc"
  },
  "homepage": "https://github.com/cnsharp/git-menu-ext-vsc#readme",
  "bugs": {
    "url": "https://github.com/cnsharp/git-menu-ext-vsc/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "resources/icon.png",
  "categories": ["SCM Providers"],
  "keywords": ["git", "branch", "export", "delete"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "extensionDependencies": ["vscode.git"],
  "contributes": {
    "commands": [
      {
        "command": "gitMenuExt.deleteBranches",
        "title": "Delete Branches...",
        "category": "Git",
        "icon": "$(trash)"
      },
      {
        "command": "gitMenuExt.deleteOutdatedBranches",
        "title": "Delete Outdated Branches...",
        "category": "Git",
        "icon": "$(warning)"
      },
      {
        "command": "gitMenuExt.exportChangedFiles",
        "title": "Export Changed Files...",
        "category": "Git",
        "icon": "$(file-zip)"
      },
      {
        "command": "gitMenuExt.squashCommits",
        "title": "Squash Commits...",
        "category": "Git",
        "icon": "$(fold)"
      },
      {
        "command": "gitMenuExt.editCommitMessage",
        "title": "Edit Commit Message...",
        "category": "Git",
        "icon": "$(edit)"
      },
      {
        "command": "gitMenuExt.stageChanges",
        "title": "Stage Changes",
        "category": "Git"
      },
      {
        "command": "gitMenuExt.unstageChanges",
        "title": "Unstage Changes",
        "category": "Git"
      },
      {
        "command": "gitMenuExt.discardChanges",
        "title": "Discard Changes",
        "category": "Git"
      },
      {
        "command": "gitMenuExt.openChanges",
        "title": "Open Changes",
        "category": "Git"
      },
      {
        "command": "gitMenuExt.showFileHistory",
        "title": "Show File History",
        "category": "Git",
        "icon": "$(history)"
      },
      {
        "command": "gitMenuExt.compareWithBranch",
        "title": "Compare with Branch...",
        "category": "Git",
        "icon": "$(git-compare)"
      }
    ],
    "submenus": [
      {
        "id": "gitMenuExt.editorContext",
        "label": "Git"
      },
      {
        "id": "gitMenuExt.explorerContext",
        "label": "Git"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "gitMenuExt.editorContext",
          "group": "z_gitMenuExt",
          "when": "resourceScheme == file && gitMenuExt.inRepo"
        }
      ],
      "explorer/context": [
        {
          "submenu": "gitMenuExt.explorerContext",
          "group": "z_gitMenuExt",
          "when": "resourceScheme == file"
        }
      ],
      "gitMenuExt.explorerContext": [
        {
          "command": "gitMenuExt.compareWithBranch",
          "group": "1_diff@1"
        },
        {
          "command": "gitMenuExt.showFileHistory",
          "group": "1_diff@2"
        }
      ],
      "gitMenuExt.editorContext": [
        {
          "command": "gitMenuExt.stageChanges",
          "group": "1_changes@1",
          "when": "gitMenuExt.canStage"
        },
        {
          "command": "gitMenuExt.unstageChanges",
          "group": "1_changes@2",
          "when": "gitMenuExt.canUnstage"
        },
        {
          "command": "gitMenuExt.discardChanges",
          "group": "1_changes@3",
          "when": "gitMenuExt.canStage"
        },
        {
          "command": "gitMenuExt.openChanges",
          "group": "2_diff@1",
          "when": "gitMenuExt.hasChanges"
        },
        {
          "command": "gitMenuExt.compareWithBranch",
          "group": "2_diff@2"
        },
        {
          "command": "gitMenuExt.showFileHistory",
          "group": "2_diff@3"
        }
      ],
      "scm/title": [
        {
          "command": "gitMenuExt.deleteBranches",
          "group": "gitMenuExt@1"
        },
        {
          "command": "gitMenuExt.deleteOutdatedBranches",
          "group": "gitMenuExt@2"
        },
        {
          "command": "gitMenuExt.exportChangedFiles",
          "group": "gitMenuExt@3"
        },
        {
          "command": "gitMenuExt.squashCommits",
          "group": "gitMenuExt@4"
        },
        {
          "command": "gitMenuExt.editCommitMessage",
          "group": "gitMenuExt@5"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "yazl": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/yazl": "^2.4.5",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.3.0"
  }
}
